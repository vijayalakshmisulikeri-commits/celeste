# Copy this file to .env and fill in real values for local development.
# NEVER commit the real .env file to GitHub -- only this example file.

# Get this from MongoDB Atlas (https://www.mongodb.com/cloud/atlas) after
# creating a free cluster: Database > Connect > Drivers > copy the URI,
# then replace <password> with your database user's password.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

DB_NAME=celeste

# Generate a real random secret with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-this-with-a-real-random-secret
